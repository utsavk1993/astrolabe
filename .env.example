# Copy this file to .env and paste your free key from https://build.nvidia.com
# (sign in → pick the Nemotron model → "Get API Key"). .env stays on your machine.
NVIDIA_API_KEY=nvapi-your-key-here
# Optional: a different vision model from build.nvidia.com
# NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# Optional: let the model reason first. More careful, but ~45 s per request instead of ~1 s.
# NVIDIA_THINKING=1

# --- Hosting publicly (see README → Deploying to Vercel) ---
# On Vercel, set these in the project's Environment Variables instead of a file.
# UPSTASH_REDIS_REST_URL=...   # shared rate-limit counters (added by Vercel's Upstash integration)
# UPSTASH_REDIS_REST_TOKEN=...
# HOST=0.0.0.0           # listen beyond localhost (needed on cloud hosts)
# TRUST_PROXY=1          # behind a load balancer: identify visitors by X-Forwarded-For
# RATE_PER_MINUTE=6      # AI requests per visitor per minute
# RATE_PER_DAY=40        # AI requests per visitor per day
# DAILY_CAP=500          # AI requests for everyone together per day
# MAX_CONCURRENT=3       # AI requests in flight at once
# ALLOWED_ORIGINS=https://your-site.example   # sites allowed to call the AI endpoint
